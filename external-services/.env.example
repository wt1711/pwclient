
# JWT Secret for session management
JWT_SECRET=your-super-secret-jwt-key-here

RANDOM_KEY=change-this-to-a-long-random-secret

# Redis Configuration
REDIS_URL=redis://localhost:6389
REDIS_HOST=localhost
REDIS_PORT=6389

# PostgreSQL Configuration
DATABASE_URL=postgresql://instagram_user:instagram_password@localhost:5439/instagram_chat
DB_HOST=localhost
DB_PORT=5439
DB_NAME=instagram_chat
DB_USER=instagram_user
DB_PASSWORD=instagram_password

# Next.js Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Instagram API Configuration
# Note: This app uses instagram-private-api which doesn't require API keys
# but you should be aware of Instagram's terms of service

# Development Settings
NODE_ENV=development

STRIPE_SECRET_KEY=sk_test_your_secret_key_here

MATRIX_HOST=matrix.lvbrd.xyz
